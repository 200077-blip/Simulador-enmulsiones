import React, { useState, useEffect, useRef } from 'react';
import { 
  Play, 
  RotateCcw, 
  FlaskConical, 
  Settings2, 
  Microscope, 
  ActivitySquare,
  BookOpen,
  Info
} from 'lucide-react';
import { 
  LineChart, 
  Line, 
  XAxis, 
  YAxis, 
  CartesianGrid, 
  Tooltip, 
  Legend, 
  ResponsiveContainer,
  ReferenceLine
} from 'recharts';

// --- CONSTANTES Y MODELO MATEMÁTICO ---
const MAX_ROUNDS = 6;

const INITIAL_PARAMS = {
  oilFraction: 20, // % v/v
  emulsifier: 2.5, // % m/m
  speed: 5000, // rpm
  time: 5, // min
  ph: 6.5,
  ionicStrength: 50 // mM
};

export default function EmulsionSimulator() {
  // Estado de parámetros de entrada (Formulación)
  const [params, setParams] = useState(INITIAL_PARAMS);
  
  // Estado del proceso
  const [isRunning, setIsRunning] = useState(false);
  const [round, setRound] = useState(1);
  const [history, setHistory] = useState([]);
  
  // Estado de resultados actuales
  const [results, setResults] = useState(null);
  const [droplets, setDroplets] = useState([]);
  const [dlvoData, setDlvoData] = useState([]);

  // Inicialización (cargar datos base)
  useEffect(() => {
    executeFormalCalculations(INITIAL_PARAMS, true);
  }, []);

  // Actualización en TIEMPO REAL de la Zona 2 y 3 al mover sliders
  useEffect(() => {
    let baseSize = 25000 / (params.speed * Math.pow(params.time, 0.3));
    baseSize += (params.oilFraction * 0.1);
    baseSize -= (params.emulsifier * 0.8);
    let liveDiameter = Math.max(0.5, Math.min(50, baseSize));

    generateDroplets(liveDiameter, params.oilFraction);
  }, [params]);

  // --- LÓGICA DEL MODELO ---
  const executeFormalCalculations = (currentParams, isInitial = false) => {
    // 1. Cálculo de Diámetro Medio (Semi-empírico)
    let baseSize = 25000 / (currentParams.speed * Math.pow(currentParams.time, 0.3));
    baseSize += (currentParams.oilFraction * 0.1);
    baseSize -= (currentParams.emulsifier * 0.8);
    let diameter = Math.max(0.5, Math.min(50, baseSize));
    
    // Variabilidad experimental aleatoria (+/- 5%)
    if (!isInitial) {
      const noise = 1 + (Math.random() * 0.1 - 0.05);
      diameter *= noise;
    }

    // 2. Cálculo de Potencial Zeta (mV)
    const pZetaBase = (currentParams.ph - 4.5) * -12; 
    const ionicCompression = Math.exp(-currentParams.ionicStrength / 100);
    const zetaPotential = pZetaBase * ionicCompression;

    // 3. Tensión Interfacial (mN/m)
    const interfacialTension = Math.max(1, 30 - (currentParams.emulsifier * 8));

    // 4. Estabilidad Física Estimada (0-100%)
    const sizeScore = Math.max(0, 100 - (diameter * 10)); // Óptimo < 5um
    const zetaScore = Math.min(100, Math.abs(zetaPotential) * 2.5); // Óptimo > 30mV
    const stability = (sizeScore * 0.4) + (zetaScore * 0.6);

    const newResults = {
      diameter: diameter.toFixed(2),
      zetaPotential: zetaPotential.toFixed(1),
      interfacialTension: interfacialTension.toFixed(1),
      stability: stability.toFixed(1),
      polydispersity: (0.1 + (diameter * 0.02)).toFixed(2)
    };

    setResults(newResults);
    generateDLVOCurve(zetaPotential, currentParams.ionicStrength);

    // Guardar en historial si es una ejecución (no inicial)
    if (!isInitial) {
      setHistory(prev => [...prev, { 
        round, 
        params: { ...currentParams }, 
        results: { ...newResults }
      }]);
      setRound(prev => prev + 1);
    }
    
    return newResults;
  };

  // Generar datos para visualización de microestructura (Canvas/SVG conceptual)
  const generateDroplets = (avgDiameter, oilFraction) => {
    const numDroplets = Math.min(200, Math.floor((oilFraction * 15) / Math.max(1, avgDiameter)));
    const newDroplets = [];
    for (let i = 0; i < numDroplets; i++) {
      // Variación de tamaño para simular polidispersidad
      const sizeVar = avgDiameter * (0.8 + Math.random() * 0.4);
      // Radio visual escalado
      const r = Math.max(2, Math.min(30, sizeVar * 4)); 
      newDroplets.push({
        id: i,
        cx: 5 + Math.random() * 90, // %
        cy: 5 + Math.random() * 90, // %
        r: r,
        opacity: 0.6 + Math.random() * 0.4
      });
    }
    setDroplets(newDroplets);
  };

  // Generar curva DLVO conceptual
  const generateDLVOCurve = (zeta, ionicStrength) => {
    const data = [];
    const kappa = 0.5 + (ionicStrength * 0.05); // Constante de Debye inversa aproximada
    const surfacePotential = Math.pow(zeta, 2) * 0.01; 
    const hamaker = 5; // Constante de Hamaker arbitraria para atracción

    for (let x = 0.5; x <= 15; x += 0.5) {
      const vR = surfacePotential * Math.exp(-kappa * x); // Repulsión electrostática
      const vA = -hamaker / x; // Atracción de Van der Waals
      const vTotal = vR + vA;
      data.push({
        distancia: x,
        vR: vR,
        vA: vA,
        vTotal: vTotal
      });
    }
    setDlvoData(data);
  };

  // --- MANEJADORES DE EVENTOS ---
  const handleParamChange = (e) => {
    const { name, value } = e.target;
    setParams(prev => ({ ...prev, [name]: parseFloat(value) }));
  };

  const executeExperiment = () => {
    if (round > MAX_ROUNDS) return;
    
    setIsRunning(true);
    // Simular tiempo de procesamiento de homogeneización
    setTimeout(() => {
      executeFormalCalculations(params, false);
      setIsRunning(false);
    }, 1500); // 1.5s de animación
  };

  const resetPractice = () => {
    if (window.confirm('¿Estás seguro de que deseas reiniciar la práctica completa? Perderás el historial.')) {
      setParams(INITIAL_PARAMS);
      setRound(1);
      setHistory([]);
      executeFormalCalculations(INITIAL_PARAMS, true);
    }
  };

  // --- COMPONENTES UI AUXILIARES ---
  const SliderControl = ({ label, name, min, max, step, unit, value }) => (
    <div className="mb-4">
      <div className="flex justify-between items-center mb-1">
        <label className="text-sm font-medium text-slate-300">{label}</label>
        <span className="text-xs font-mono text-cyan-400 bg-slate-800 px-2 py-1 rounded">
          {value} {unit}
        </span>
      </div>
      <input
        type="range"
        name={name}
        min={min}
        max={max}
        step={step}
        value={value}
        onChange={handleParamChange}
        disabled={isRunning}
        className="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-cyan-500"
      />
    </div>
  );

  return (
    <div className="min-h-screen bg-slate-950 text-slate-200 font-sans p-4 md:p-6 selection:bg-cyan-900">
      {/* ESTILOS CSS PARA ANIMACIONES */}
      <style>{`
        @keyframes spin {
          0% { transform: rotate(0deg); }
          100% { transform: rotate(360deg); }
        }
        @keyframes bubble {
          0% { transform: translateY(0) scale(1); opacity: 0.8; }
          100% { transform: translateY(-40px) scale(1.5); opacity: 0; }
        }
        .animate-spin-fast { animation: spin 0.2s linear infinite; }
        .bubble-anim { animation: bubble 1.5s infinite ease-in; }
      `}</style>

      {/* HEADER */}
      <header className="flex flex-col md:flex-row justify-between items-center mb-6 pb-4 border-b border-slate-800">
        <div>
          <h1 className="text-2xl font-bold text-white flex items-center gap-2">
            <FlaskConical className="text-cyan-500" />
            VisualizeLearning V2
          </h1>
          <p className="text-slate-400 text-sm mt-1">Laboratorio de Obtención y Estabilización de Emulsiones</p>
        </div>
        <div className="flex items-center gap-4 mt-4 md:mt-0">
          <div className="bg-slate-900 border border-slate-700 px-4 py-2 rounded-lg flex items-center gap-2">
            <span className="text-sm text-slate-400">Ronda:</span>
            <span className="font-bold text-cyan-400 text-lg">{round <= MAX_ROUNDS ? round : MAX_ROUNDS} / {MAX_ROUNDS}</span>
          </div>
          <button 
            onClick={resetPractice}
            className="p-2 hover:bg-slate-800 text-slate-400 hover:text-white rounded transition-colors"
            title="Reiniciar Práctica"
          >
            <RotateCcw size={20} />
          </button>
        </div>
      </header>

      {/* MAIN GRID */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        {/* COLUMNA IZQUIERDA: Formulación y Proceso */}
        <div className="lg:col-span-4 space-y-6">
          
          {/* ZONA 1: Formulación */}
          <section className="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-lg">
            <h2 className="text-lg font-semibold mb-4 flex items-center gap-2 text-white border-b border-slate-800 pb-2">
              <Settings2 size={18} className="text-cyan-500"/>
              Zona 1. Formulación y Medio
            </h2>
            
            <div className="space-y-1">
              <SliderControl label="Fracción de Aceite" name="oilFraction" min="5" max="40" step="1" unit="% v/v" value={params.oilFraction} />
              <SliderControl label="Emulsificante" name="emulsifier" min="0.1" max="5" step="0.1" unit="% m/m" value={params.emulsifier} />
              <SliderControl label="Fuerza Iónica" name="ionicStrength" min="0" max="200" step="10" unit="mM" value={params.ionicStrength} />
              <SliderControl label="pH (Fase Acuosa)" name="ph" min="3" max="10" step="0.1" unit="" value={params.ph} />
              
              <div className="pt-4 mt-4 border-t border-slate-800">
                <h3 className="text-sm font-medium text-slate-400 mb-3">Parámetros de Proceso</h3>
                <SliderControl label="Velocidad Homogeneización" name="speed" min="1000" max="15000" step="500" unit="rpm" value={params.speed} />
                <SliderControl label="Tiempo" name="time" min="1" max="10" step="1" unit="min" value={params.time} />
              </div>
            </div>

            <button 
              onClick={executeExperiment}
              disabled={isRunning || round > MAX_ROUNDS}
              className={`w-full mt-6 py-3 px-4 rounded-lg font-bold flex items-center justify-center gap-2 transition-all shadow-lg
                ${isRunning 
                  ? 'bg-slate-700 text-slate-400 cursor-not-allowed' 
                  : round > MAX_ROUNDS 
                    ? 'bg-green-600/50 text-green-200 cursor-not-allowed'
                    : 'bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white shadow-cyan-900/50 hover:shadow-cyan-900'
                }`}
            >
              {isRunning ? (
                <>Procesando... <RotateCcw className="animate-spin" size={18} /></>
              ) : round > MAX_ROUNDS ? (
                'Práctica Finalizada'
              ) : (
                <>EJECUTAR EXPERIMENTO <Play size={18} fill="currentColor" /></>
              )}
            </button>
          </section>

          {/* ZONA 2: Proceso (Animación) */}
          <section className="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-lg flex flex-col">
            <h2 className="text-lg font-semibold mb-4 flex items-center gap-2 text-white border-b border-slate-800 pb-2">
              <ActivitySquare size={18} className="text-blue-500"/>
              Zona 2. Proceso
            </h2>
            
            <div className="flex-1 flex items-center justify-center min-h-[200px] bg-slate-950 rounded-lg relative overflow-hidden border border-slate-800/50 p-4">
              
              {/* Vaso de Precipitados SVG */}
              <div className="relative w-32 h-40">
                {/* Contorno del vaso */}
                <div className="absolute inset-0 border-4 border-slate-600 border-t-0 rounded-b-xl z-20"></div>
                {/* Líneas de medición */}
                <div className="absolute left-0 bottom-4 w-3 h-0.5 bg-slate-600 z-20"></div>
                <div className="absolute left-0 bottom-12 w-4 h-0.5 bg-slate-600 z-20"></div>
                <div className="absolute left-0 bottom-20 w-3 h-0.5 bg-slate-600 z-20"></div>
                
                {/* Líquido */}
                <div className={`absolute bottom-0 left-0 right-0 rounded-b-lg transition-all duration-300 z-10 bg-cyan-500`}
                  style={{ 
                    height: `${45 + params.oilFraction + (isRunning ? 5 : 0)}%`, 
                    opacity: 0.3 + (params.emulsifier / 5) * 0.7 
                  }}>
                  
                  {/* Propela de agitación */}
                  <div className="absolute bottom-2 left-1/2 transform -translate-x-1/2 flex flex-col items-center">
                    <div className="w-1 h-20 bg-slate-400"></div>
                    <div className={`w-12 h-2 bg-slate-300 rounded ${isRunning ? 'animate-spin-fast' : ''}`}></div>
                  </div>

                  {/* Burbujas si está corriendo */}
                  {isRunning && (
                    <>
                      <div className="absolute left-[20%] bottom-4 w-2 h-2 bg-white rounded-full bubble-anim" style={{ animationDelay: '0.1s' }}></div>
                      <div className="absolute left-[70%] bottom-8 w-3 h-3 bg-white rounded-full bubble-anim" style={{ animationDelay: '0.4s' }}></div>
                      <div className="absolute left-[40%] bottom-2 w-1 h-1 bg-white rounded-full bubble-anim" style={{ animationDelay: '0.2s' }}></div>
                    </>
                  )}
                </div>
              </div>

              {isRunning && (
                <div className="absolute inset-0 bg-slate-950/50 backdrop-blur-sm flex items-center justify-center z-30">
                  <span className="text-cyan-400 font-mono tracking-widest animate-pulse">HOMOGENEIZANDO...</span>
                </div>
              )}
            </div>
          </section>
        </div>

        {/* COLUMNA CENTRAL Y DERECHA: Microestructura y Resultados */}
        <div className="lg:col-span-8 space-y-6 flex flex-col">
          
          <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
            {/* ZONA 3: Microestructura */}
            <section className="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-lg">
              <h2 className="text-lg font-semibold mb-4 flex items-center gap-2 text-white border-b border-slate-800 pb-2">
                <Microscope size={18} className="text-purple-500"/>
                Zona 3. Microestructura
              </h2>
              <div className="aspect-square w-full bg-black rounded-lg border border-slate-700 relative overflow-hidden">
                <svg width="100%" height="100%" className="absolute inset-0">
                  <rect width="100%" height="100%" fill="#0a192f" />
                  {droplets.map(drop => (
                    <circle
                      key={drop.id}
                      cx={`${drop.cx}%`}
                      cy={`${drop.cy}%`}
                      r={drop.r}
                      fill="#e2e8f0" // Color aceite
                      fillOpacity={drop.opacity}
                      stroke="#94a3b8"
                      strokeWidth="1"
                    />
                  ))}
                </svg>
                {/* Barra de escala */}
                <div className="absolute bottom-2 right-2 bg-black/60 px-2 py-1 rounded border border-slate-700 flex flex-col items-center">
                  <div className="w-16 h-[1px] bg-white mb-1"></div>
                  <span className="text-[10px] text-slate-300 font-mono">10 µm</span>
                </div>
              </div>
            </section>

            {/* ZONA 4A: Resultados Numéricos */}
            <section className="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-lg flex flex-col">
              <h2 className="text-lg font-semibold mb-4 flex items-center gap-2 text-white border-b border-slate-800 pb-2">
                <ActivitySquare size={18} className="text-green-500"/>
                Zona 4. Resultados Analíticos
              </h2>
              
              {results && (
                <div className="grid grid-cols-2 gap-3 flex-1">
                  <div className="bg-slate-950 p-3 rounded-lg border border-slate-800 flex flex-col justify-center">
                    <span className="text-xs text-slate-400">Diámetro Promedio</span>
                    <span className="text-2xl font-mono text-white">{results.diameter} <span className="text-sm">µm</span></span>
                  </div>
                  <div className="bg-slate-950 p-3 rounded-lg border border-slate-800 flex flex-col justify-center">
                    <span className="text-xs text-slate-400">Potencial Zeta</span>
                    <span className={`text-2xl font-mono ${parseFloat(results.zetaPotential) < -30 ? 'text-green-400' : 'text-orange-400'}`}>
                      {results.zetaPotential} <span className="text-sm">mV</span>
                    </span>
                  </div>
                  <div className="bg-slate-950 p-3 rounded-lg border border-slate-800 flex flex-col justify-center">
                    <span className="text-xs text-slate-400">Tensión Interfacial</span>
                    <span className="text-2xl font-mono text-white">{results.interfacialTension} <span className="text-sm">mN/m</span></span>
                  </div>
                  <div className="bg-slate-950 p-3 rounded-lg border border-slate-800 flex flex-col justify-center">
                    <span className="text-xs text-slate-400">Estabilidad Estimada</span>
                    <span className="text-2xl font-mono text-cyan-400">{results.stability} <span className="text-sm">%</span></span>
                  </div>
                  <div className="col-span-2 bg-slate-950 p-3 rounded-lg border border-slate-800">
                    <span className="text-xs text-slate-400 block mb-1">Diagnóstico Rápido</span>
                    <p className="text-sm text-slate-300">
                      {parseFloat(results.diameter) > 10 ? 'Riesgo alto de coalescencia por tamaño de gota grande. ' : 'Tamaño de gota adecuado. '}
                      {Math.abs(parseFloat(results.zetaPotential)) < 20 ? 'Baja repulsión electrostática, riesgo de floculación. ' : 'Buena barrera electrostática. '}
                    </p>
                  </div>
                </div>
              )}
            </section>
          </div>

          {/* ZONA 4B: Curva DLVO y Tabla de Historial */}
          <section className="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-lg flex-1">
             <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 h-full">
                {/* Gráfica DLVO */}
                <div className="flex flex-col">
                  <h3 className="text-sm font-semibold mb-2 flex items-center gap-1 text-slate-300">
                    <ActivitySquare size={14}/> Modelo DLVO Conceptual
                  </h3>
                  <div className="h-48 w-full bg-slate-950 rounded-lg border border-slate-800 p-2">
                    <ResponsiveContainer width="100%" height="100%">
                      <LineChart data={dlvoData} margin={{ top: 5, right: 5, left: -20, bottom: 0 }}>
                        <CartesianGrid strokeDasharray="3 3" stroke="#1e293b" />
                        <XAxis dataKey="distancia" stroke="#64748b" tick={{fontSize: 10}} label={{ value: 'Distancia (nm)', position: 'insideBottomRight', offset: -5, fill: '#64748b', fontSize:10 }} />
                        <YAxis stroke="#64748b" tick={{fontSize: 10}} />
                        <Tooltip contentStyle={{backgroundColor: '#0f172a', borderColor: '#1e293b'}} itemStyle={{fontSize: '12px'}} labelStyle={{display: 'none'}} />
                        <ReferenceLine y={0} stroke="#475569" />
                        <Line type="monotone" dataKey="vTotal" name="V. Total" stroke="#06b6d4" strokeWidth={2} dot={false} />
                        <Line type="monotone" dataKey="vR" name="Repulsión" stroke="#22c55e" strokeWidth={1} strokeDasharray="5 5" dot={false} />
                        <Line type="monotone" dataKey="vA" name="Atracción" stroke="#ef4444" strokeWidth={1} strokeDasharray="5 5" dot={false} />
                      </LineChart>
                    </ResponsiveContainer>
                  </div>
                </div>

                {/* Historial */}
                <div className="flex flex-col">
                  <h3 className="text-sm font-semibold mb-2 flex items-center gap-1 text-slate-300">
                    <BookOpen size={14}/> Historial de Experimentos
                  </h3>
                  <div className="flex-1 bg-slate-950 rounded-lg border border-slate-800 overflow-y-auto max-h-48">
                    <table className="w-full text-left text-xs text-slate-300">
                      <thead className="bg-slate-900 sticky top-0">
                        <tr>
                          <th className="p-2 border-b border-slate-800">R</th>
                          <th className="p-2 border-b border-slate-800">Aceite</th>
                          <th className="p-2 border-b border-slate-800">Emuls.</th>
                          <th className="p-2 border-b border-slate-800">Vel.</th>
                          <th className="p-2 border-b border-slate-800">D (µm)</th>
                          <th className="p-2 border-b border-slate-800">Zeta (mV)</th>
                        </tr>
                      </thead>
                      <tbody>
                        {history.length === 0 ? (
                          <tr><td colSpan="6" className="p-4 text-center text-slate-500">No hay experimentos registrados.</td></tr>
                        ) : (
                          history.map((h, i) => (
                            <tr key={i} className="border-b border-slate-800/50 hover:bg-slate-800/30">
                              <td className="p-2">{h.round}</td>
                              <td className="p-2">{h.params.oilFraction}%</td>
                              <td className="p-2">{h.params.emulsifier}%</td>
                              <td className="p-2">{h.params.speed}</td>
                              <td className="p-2 font-mono text-cyan-400">{h.results.diameter}</td>
                              <td className="p-2 font-mono">{h.results.zetaPotential}</td>
                            </tr>
                          ))
                        )}
                      </tbody>
                    </table>
                  </div>
                </div>
             </div>
          </section>

        </div>
      </div>
    </div>
  );
}
